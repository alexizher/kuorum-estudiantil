{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": { "outputs": ["src/generated/**"] },
    "build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**", ".next/**"] },
    "lint": {},
    "//#lint:raiz": {
      "inputs": ["eslint.config.mjs", "vitest.config.ts", ".dependency-cruiser.cjs"]
    },
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"] },
    "test:int": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
