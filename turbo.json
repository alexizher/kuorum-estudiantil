{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": { "outputs": ["src/generated/**"] },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "KUORUM_SECRETO",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "KUORUM_INSTITUCION_NOMBRE",
        "KUORUM_MODO_DEMO",
        "KUORUM_DEMO_CORREO",
        "KUORUM_DEMO_CONTRASENA",
        "KUORUM_DETRAS_DE_CLOUDFLARE",
        "CRON_SECRET",
        "MICROSOFT_TENANT_ID"
      ]
    },
    "lint": {},
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"] },
    "test:int": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
