# Conexión al Postgres local de compose.yml (solo desarrollo).
DATABASE_URL=postgresql://kuorum:kuorum@localhost:54329/kuorum
# En Neon: DATABASE_URL es la pooled; DATABASE_URL_UNPOOLED se usa para migraciones.
# DATABASE_URL_UNPOOLED=
# Firma de las cookies de los participantes (HMAC). Obligatoria: sin ella la API de la sala responde 500.
# Genera una con: openssl rand -base64 32
# KUORUM_SECRETO=
# Firma de las sesiones de la mesa (Better Auth). Obligatoria para ingresar a la mesa.
# BETTER_AUTH_SECRET=
# Dirección pública del sitio. Déjala vacía en local y en Vercel, que la deduce sola.
# BETTER_AUTH_URL=
# Pon 1 solo si Cloudflare está delante y Vercel solo es alcanzable por él: el límite de ingreso usa cf-connecting-ip.
# KUORUM_DETRAS_DE_CLOUDFLARE=
# Cuenta de prueba pública (opcional). Con KUORUM_MODO_DEMO=1 el ingreso muestra su correo y su contraseña.
# La cuenta se crea aparte, con: crear-admin --rol DEMO (ver docs/despliegue.md).
# KUORUM_MODO_DEMO=
# KUORUM_DEMO_CORREO=
# KUORUM_DEMO_CONTRASENA=
# Secreto de la limpieza diaria de la cuenta de prueba. Vercel lo manda como "Authorization: Bearer ..." al cron.
# Genera uno con: openssl rand -base64 32
# CRON_SECRET=
