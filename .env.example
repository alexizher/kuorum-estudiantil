# Conexión al Postgres local de compose.yml (solo desarrollo).
DATABASE_URL=postgresql://kuorum:kuorum@localhost:54329/kuorum
# En Neon: DATABASE_URL es la pooled; DATABASE_URL_UNPOOLED se usa para migraciones.
# DATABASE_URL_UNPOOLED=
# Firma de las cookies de los participantes (HMAC). Obligatoria: sin ella la API de la sala responde 500.
# Genera una con: openssl rand -base64 32
# KUORUM_SECRETO=
# Firma de las sesiones de la mesa (Better Auth). Obligatoria para ingresar a la mesa.
# BETTER_AUTH_SECRET=
# Dirección pública del sitio. Déjala vacía en local y en Vercel, que la deduce sola.
# BETTER_AUTH_URL=
