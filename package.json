{
  "name": "kuorum-estudiantil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "depcheck": "depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "desplegar": "pnpm --filter @kuorum/cli build && node packages/cli/dist/index.js desplegar"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "~2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
