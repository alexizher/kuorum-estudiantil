{
  "name": "@kuorum/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm generate && vitest run",
    "test:int": "pnpm generate && vitest run --config vitest.int.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@kuorum/domain": "workspace:*",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
