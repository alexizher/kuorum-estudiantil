generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoDeSesion {
  PROGRAMADA
  ABIERTA
  EN_CURSO
  CERRADA
  ACTA_FINAL
  CANCELADA
}

enum ModoDeParticipacion {
  SALA_ABIERTA
  CON_CODIGOS
}

enum CredencialDeParticipante {
  CODIGO
  NAVEGADOR
}

enum EstadoDePregunta {
  BORRADOR
  ABIERTA
  CERRADA
  ANULADA
}

enum EstadoDeSolicitud {
  ESPERANDO
  CON_LA_PALABRA
  TERMINADA
  RETIRADA
  RECHAZADA
}

enum TipoDeSolicitud {
  INTERVENCION
  MOCION
}

// Tipo de cuenta. SUPERADMIN administra la instalación; MESA es el personal y sus permisos
// salen de sus membresías; DEMO es la cuenta de prueba y solo ve lo que creó.
enum RolDeMesa {
  SUPERADMIN
  MESA
  DEMO
}

enum TipoDeCuerpo {
  GENERAL
  FACULTAD
}

// ENCARGADO programa y conduce las sesiones de su cuerpo; MESA solo las conduce.
enum RolEnCuerpo {
  ENCARGADO
  MESA
}

enum Modalidad {
  PRESENCIAL
  VIRTUAL
  MIXTA
}

enum TipoDeMocion {
  ORDEN
  PROCEDIMIENTO
  ACLARACION
  SUFICIENTE_ILUSTRACION
}

// Una sola fila: la crea la migración.
model Institucion {
  id                   String   @id @default("institucion")
  nombre               String
  tipoDeCuerpoSingular String
  tipoDeCuerpoPlural   String
  zonaHoraria          String
  logoUrl              String?
  colorPrimario        String?
  colorSecundario      String?
  pieDePagina          String?
  textoBienvenida      String?
  proveedorOAuth       String?
  clientIdOAuth        String?
  clientSecretOAuth    String?
  actualizadaEn        DateTime @updatedAt

  @@map("institucion")
}

// Una sola GENERAL: índice único parcial en la migración (Prisma no sabe expresarlo).
model Cuerpo {
  id        String       @id
  nombre    String
  tipo      TipoDeCuerpo
  slug      String       @unique
  archivado Boolean      @default(false)
  creadoEn  DateTime     @default(now())

  sesiones   Sesion[]
  membresias Membresia[]

  @@map("cuerpos")
}

model Membresia {
  usuarioId String
  cuerpoId  String
  rol       RolEnCuerpo

  usuario User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cuerpo  Cuerpo @relation(fields: [cuerpoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, cuerpoId])
  @@index([cuerpoId])
  @@map("membresias")
}

model Sesion {
  id                      String              @id @default(cuid())
  titulo                  String
  codigoDeSala            String              @unique
  modo                    ModoDeParticipacion @default(SALA_ABIERTA)
  segundosPorIntervencion Int                 @default(180)
  estado                  EstadoDeSesion      @default(PROGRAMADA)
  version                 Int                 @default(0)
  actualizadaEn           DateTime            @updatedAt
  creadaEn                DateTime            @default(now())
  // Quién la creó. Sin dueño (null) la ve el personal de su cuerpo.
  creadaPorId             String?
  cuerpoId                String
  inicio                  DateTime
  fin                     DateTime
  modalidad               Modalidad           @default(PRESENCIAL)
  lugar                   String?
  ordenDelDia             String[]            @default([])

  creadaPor     User?                @relation(fields: [creadaPorId], references: [id], onDelete: SetNull)
  cuerpo        Cuerpo               @relation(fields: [cuerpoId], references: [id], onDelete: Restrict)
  participantes Participante[]
  codigos       CodigoDeAcceso[]
  preguntas     Pregunta[]
  solicitudes   SolicitudDePalabra[]
  decisiones    Decision[]
  acta          Acta?

  @@index([creadaPorId])
  @@index([inicio])
  @@index([cuerpoId, inicio])
  @@map("sesiones")
}

// Guarda solo el hash de la credencial (código de acceso o token del navegador).
model Participante {
  id         String                   @id
  sesionId   String
  credencial CredencialDeParticipante
  hash       String
  creadoEn   DateTime

  sesion      Sesion               @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  solicitudes SolicitudDePalabra[]

  @@unique([sesionId, hash])
  @@map("participantes")
}

// Solo el hash SHA-256; el texto plano existe una vez, al generarlo.
model CodigoDeAcceso {
  sesionId   String
  hash       String
  activadoEn DateTime?

  sesion Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@id([sesionId, hash])
  @@map("codigos_de_acceso")
}

// Una sola pregunta ABIERTA por sesión: índice único parcial en la migración
// (Prisma no sabe expresarlo).
model Pregunta {
  id               String           @id
  sesionId         String
  texto            String
  estado           EstadoDePregunta @default(BORRADOR)
  resultadoVisible Boolean          @default(false)
  abiertaEn        DateTime?
  cerradaEn        DateTime?
  creadaEn         DateTime         @default(now())

  sesion   Sesion        @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  opciones Opcion[]
  votos    VotoEmitido[]
  conteos  Conteo[]

  @@index([sesionId])
  @@map("preguntas")
}

model Opcion {
  id         String @id
  preguntaId String
  texto      String
  orden      Int

  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  conteos  Conteo[]

  @@unique([preguntaId, orden])
  @@map("opciones")
}

// Quién ya votó. Sin hora y sin opción: no se puede unir con conteos.
model VotoEmitido {
  preguntaId     String
  participanteId String

  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@id([preguntaId, participanteId])
  @@map("votos_emitidos")
}

// Cuántos votos tiene cada opción. Sin relación con quién votó.
model Conteo {
  preguntaId String
  opcionId   String
  total      Int    @default(0)

  pregunta Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  opcion   Opcion   @relation(fields: [opcionId], references: [id], onDelete: Cascade)

  @@id([preguntaId, opcionId])
  @@map("conteos")
}

model SolicitudDePalabra {
  id             String            @id
  sesionId       String
  participanteId String
  nombreVisible  String
  tipo           TipoDeSolicitud
  mocion         TipoDeMocion?
  estado         EstadoDeSolicitud @default(ESPERANDO)
  pedidaEn       DateTime
  inicioEn       DateTime?
  finEn          DateTime?
  segundosExtra  Int               @default(0)

  sesion       Sesion       @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  participante Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@index([sesionId, estado])
  @@map("solicitudes_de_palabra")
}

// Tablas de Better Auth (ingreso de la mesa). Los nombres de campo los fija la librería.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  // Campo propio: Better Auth no deja que el cliente lo escriba (input: false).
  rol           RolDeMesa @default(MESA)

  sessions   Session[]
  accounts   Account[]
  sesiones   Sesion[]
  membresias Membresia[]

  @@map("auth_users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

// Contador de intentos por clave (IP y ruta) para limitar el ingreso de la mesa.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

enum EstadoDeActa {
  BORRADOR
  FINAL
}

// Foto del resultado de una votación cerrada; no se recalcula.
model Decision {
  id         String   @id
  preguntaId String   @unique
  sesionId   String
  cuerpoId   String
  pregunta   String
  regla      String
  resultado  Json
  aprobada   Boolean?
  indicativa Boolean
  enunciado  String?
  consultaId String?
  cerradaEn  DateTime

  sesion Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([cuerpoId, cerradaEn])
  @@index([sesionId])
  @@map("decisiones")
}

model Acta {
  sesionId     String       @id
  desarrollo   String       @default("")
  estado       EstadoDeActa @default(BORRADOR)
  codigo       String?      @unique
  finalizadaEn DateTime?
  contenido    Json?

  sesion Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@map("actas")
}
